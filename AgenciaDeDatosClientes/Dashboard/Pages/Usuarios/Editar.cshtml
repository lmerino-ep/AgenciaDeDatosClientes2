@page "/usuarios/editar/{id:int}"
@model Pages.Usuarios.EditarModel
@using Microsoft.AspNetCore.Authorization
@using Utils.Authorization

@{
    ViewData["Title"] = "Editar Usuario";
    ViewBag.Description = "Editar información de usuario";
    ViewBag.PoliticaIndexFollow = "noindex, nofollow";
}

@section estilos {
    <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    <link href="~/css/plugins/dropdownfiltrable.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
}

<div class="page-header">
    <h1 class="page-title">Editar Usuario</h1>
    <div class="breadcrumb">
        <a href="/">Dashboard</a>
        <span class="separador">/</span>
        <a href="/usuarios/listado">Usuarios</a>
        <span class="separador">/</span>
        <span>Editar</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alerta alerta-error">
        @Model.MensajeError
    </div>
}

<form method="post" class="form-usuario">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alerta alerta-error"></div>
    }

    <input type="hidden" asp-for="Modelo.Id" />

    <section class="seccion-formulario">
        <div class="card">
            <h2 class="titulo-seccion">Información del Usuario</h2>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Modelo.Email" class="form-control" readonly />
                <small class="form-text text-muted">El email no se puede modificar</small>
            </div>

            <div class="form-group">
                <label asp-for="Modelo.Nombre">Nombre *</label>
                <input asp-for="Modelo.Nombre" class="form-control" required />
                <span asp-validation-for="Modelo.Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Modelo.Apellidos">Apellidos *</label>
                <input asp-for="Modelo.Apellidos" class="form-control" required />
                <span asp-validation-for="Modelo.Apellidos" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Modelo.Empresa">Empresa</label>
                <input asp-for="Modelo.Empresa" class="form-control" />
                <span asp-validation-for="Modelo.Empresa" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Modelo.FK_UsuarioTipo">Tipo de Usuario *</label>
                <select asp-for="Modelo.FK_UsuarioTipo" class="form-control" required>
                    @foreach (var tipo in Model.TiposUsuario)
                    {
                        <option value="@tipo.Id" selected="@(Model.Modelo.FK_UsuarioTipo == tipo.Id)">@tipo.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Modelo.FK_UsuarioTipo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>
                    <input asp-for="Modelo.Activo" type="checkbox" />
                    Usuario Activo
                </label>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="boton boton-primario">Guardar Cambios</button>
        <a href="/usuarios/listado" class="boton boton-secundario">Cancelar</a>
        <a href="/usuarios/cambiar-contrasena/@Model.Id" class="boton boton-secundario">Cambiar Contraseña</a>
    </div>
</form>

@if (Model.Usuario != null && Model.Usuario.Activo)
{
    <section class="seccion-eliminar">
        <div class="card">
            <h2 class="titulo-seccion">Zona de Peligro</h2>
            
            @if (User.IsInRole("Dashboard - Gestión de Usuarios"))
            {
                <form method="post" asp-page-handler="Desactivar" onsubmit="return confirm('¿Estás seguro de que deseas desactivar este usuario? Esta acción quedará registrada en la auditoría.');">
                    @Html.AntiForgeryToken()
                    <div class="alerta alerta-advertencia">
                        <p><strong>ADVERTENCIA:</strong> Esta acción marcará el usuario como inactivo (soft delete). El usuario no podrá iniciar sesión, pero sus datos se conservarán en el sistema.</p>
                    </div>
                    <button type="submit" class="boton boton-peligro">Desactivar Usuario</button>
                </form>
            }

            @if (User.IsInRole("Dashboard - Acceso total"))
            {
                <form method="post" asp-page-handler="EliminarDefinitivamente" id="formEliminarDefinitivamente" data-js-form-eliminar-definitivamente>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idUsuarioHereditario" name="idUsuarioHereditario" />
                    <div class="alerta alerta-error">
                        <p><strong>ADVERTENCIA CRÍTICA:</strong> Esta acción eliminará permanentemente el usuario y todos sus datos asociados. Esta acción NO es reversible. Toda la información del usuario será transferida al usuario seleccionado.</p>
                    </div>
                    @if (Model.DropdownUsuariosHerencia != null && Model.DropdownUsuariosHerencia.Elementos != null && Model.DropdownUsuariosHerencia.Elementos.Count > 0)
                    {
                        <div class="form-group form-group-eliminar-usuario">
                            <label for="dropdownUsuarioHerencia">Usuario que heredará la información *</label>
                            <div class="dropdown-container">
                                @await Html.PartialAsync("Shared/Components/Herramientas/DropdownFiltrable", Model.DropdownUsuariosHerencia)
                                <button type="submit" class="boton boton-peligro boton-eliminar-usuario">Eliminar Usuario</button>
                            </div>
                            <small class="form-text text-muted">Selecciona el usuario que recibirá toda la información asociada al usuario que se va a eliminar.</small>
                        </div>
                    }
                    else
                    {
                        <div class="alerta alerta-advertencia">
                            <p>No hay usuarios disponibles con tipo 4 o 5 para heredar la información. No se puede eliminar este usuario definitivamente.</p>
                        </div>
                    }
                </form>
            }
        </div>
    </section>
}

<!-- Modal de confirmación de eliminación definitiva -->
<div id="modalConfirmarEliminacion" class="modal-confirmacion" style="display: none;">
    <div class="modal-confirmacion-contenido">
        <div class="modal-confirmacion-header">
            <h3>Confirmar Eliminación Definitiva</h3>
        </div>
        <div class="modal-confirmacion-body">
            <div class="alerta alerta-error">
                <p><strong>ADVERTENCIA CRÍTICA:</strong></p>
                <p>¿ESTÁ COMPLETAMENTE SEGURO de que desea eliminar este usuario de forma permanente?</p>
                <p>Esta acción <strong>NO se puede deshacer</strong>. Todos los datos del usuario serán transferidos al usuario seleccionado y el usuario será eliminado definitivamente.</p>
            </div>
        </div>
        <div class="modal-confirmacion-footer">
            <button type="button" class="boton boton-secundario" id="btnCancelarEliminacion">Cancelar</button>
            <button type="button" class="boton boton-peligro" id="btnConfirmarEliminacion">Eliminar Usuario</button>
        </div>
    </div>
</div>

@section scripts {
    <environment include="Development">
        <script defer src="~/js/main/usuarios-editar.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script defer src="~/js/main/usuarios-editar.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
}

