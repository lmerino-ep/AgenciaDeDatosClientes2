@page "/documentacion/sobrescribir"
@model Pages.Documentacion.SobrescribirModel
@using Microsoft.AspNetCore.Authorization
@using Utils.Authorization

@{
    ViewData["Title"] = "Subir Nueva Versión";
    ViewBag.Description = "Subir una nueva versión de un documento existente en S3";
    ViewBag.PoliticaIndexFollow = "noindex, nofollow";
}

@section estilos {
    <environment include="Development">
        <link href="~/css/plugins/modalcargando.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
    <environment include="Staging,Production">
        <link href="~/css/plugins/modalcargando.min.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
}

@section scripts {
    <environment include="Development">
        <script defer src="~/js/plugins/modalcargando.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-sobrescribir.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script defer src="~/js/plugins/modalcargando.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-sobrescribir.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
}

<div class="page-header">
    <h1 class="page-title">Subir Nueva Versión</h1>
    <div class="breadcrumb">
        <a href="/">Dashboard</a>
        <span class="separador">/</span>
        <a href="/documentacion/listado">Documentación</a>
        <span class="separador">/</span>
        <span>Nueva Versión</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alerta alerta-exito">
        @Model.MensajeExito
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alerta alerta-error">
        @Model.MensajeError
    </div>
}

@if (!string.IsNullOrEmpty(Model.NombreArchivoActual))
{
    <section class="seccion-datos-usuario">
        <div class="card">
            <h2 class="titulo-seccion">Archivo Actual</h2>
            <div class="info-usuario">
                <div class="campo">
                    <span class="etiqueta">Nombre:</span>
                    <span class="valor">@Model.NombreArchivoActual</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.CarpetaRuta))
                {
                    <div class="campo">
                        <span class="etiqueta">Ruta:</span>
                        <span class="valor">@Model.CarpetaRuta</span>
                    </div>
                }
                else
                {
                    <div class="campo">
                        <span class="etiqueta">Ruta:</span>
                        <span class="valor">Raíz de documentación</span>
                    </div>
                }
            </div>
        </div>
    </section>
}

<form method="post" enctype="multipart/form-data" class="form-usuario" data-js-form-sobrescribir data-nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alerta alerta-error"></div>
    }

    <section class="seccion-formulario">
        <div class="card">
            <h2 class="titulo-seccion">Nuevo Archivo</h2>

            <div class="alerta alerta-advertencia">
                <strong>INFORMACIÓN:</strong> Esta acción subirá una nueva versión del archivo.
            </div>

            <div class="form-group">
                <label asp-for="Archivo">Seleccionar nuevo archivo *</label>
                <input asp-for="Archivo" type="file" class="form-control" required />
                <small class="form-text text-muted">
                    Tipos permitidos: PDF, Word (DOCX), Excel (XLSX), PowerPoint (PPTX), Imágenes (PNG, JPG), Texto (TXT, MD).<br />
                    Tamaño máximo: 50 MB
                </small>
                <span asp-validation-for="Archivo" class="text-danger"></span>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="boton boton-primario">Subir Nueva Versión</button>
        <a href="/documentacion/listado@(!string.IsNullOrEmpty(Model.CarpetaRuta) ? $"?CarpetaRuta={Uri.EscapeDataString(Model.CarpetaRuta)}" : "")" class="boton boton-secundario">Cancelar</a>
    </div>
</form>

