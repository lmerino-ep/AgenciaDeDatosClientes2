@page "/documentacion/subir"
@model Pages.Documentacion.SubirModel
@using Microsoft.AspNetCore.Authorization
@using Utils.Authorization

@{
    ViewData["Title"] = "Subir Documento";
    ViewBag.Description = "Subir un nuevo documento a S3";
    ViewBag.PoliticaIndexFollow = "noindex, nofollow";
}

@section estilos {
    <environment include="Development">
        <link href="~/css/plugins/modalcargando.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
    <environment include="Staging,Production">
        <link href="~/css/plugins/modalcargando.min.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
}

@section scripts {
    <environment include="Development">
        <script defer src="~/js/plugins/modalcargando.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-subir.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script defer src="~/js/plugins/modalcargando.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-subir.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
}

<div class="page-header">
    <h1 class="page-title">Subir Documento</h1>
    <div class="breadcrumb">
        <a href="/">Dashboard</a>
        <span class="separador">/</span>
        <a href="/documentacion/listado">Documentación</a>
        <span class="separador">/</span>
        <span>Subir</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alerta alerta-exito">
        @Model.MensajeExito
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alerta alerta-error">
        @Model.MensajeError
    </div>
}

<form method="post" enctype="multipart/form-data" class="form-usuario" data-js-form-subir data-nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alerta alerta-error"></div>
    }

    <section class="seccion-formulario">
        <div class="card">
            <h2 class="titulo-seccion">Información del Archivo</h2>

            @if (!string.IsNullOrEmpty(Model.CarpetaRuta))
            {
                <div class="form-group">
                    <label>Ruta de destino:</label>
                    <div class="ruta-destino">
                        <span class="ruta-texto">@Model.CarpetaRuta</span>
                    </div>
                    <small class="form-text text-muted">
                        El archivo se subirá en esta ubicación.
                    </small>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Ruta de destino:</label>
                    <div class="ruta-destino">
                        <span class="ruta-texto">Raíz de documentación</span>
                    </div>
                    <small class="form-text text-muted">
                        El archivo se subirá en la raíz de la documentación.
                    </small>
                </div>
            }

            <div class="form-group">
                <label for="Archivos">Seleccionar archivo(s) *</label>
                <input id="Archivos" name="Archivos" type="file" class="form-control" accept=".pdf,.doc,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.txt,.md" multiple required />
                <small class="form-text text-muted">
                    Puede seleccionar uno o varios archivos a la vez.<br />
                    Tipos permitidos: PDF, Word (DOC, DOCX), Excel (XLSX), PowerPoint (PPTX), Imágenes (PNG, JPG), Texto (TXT, MD).<br />
                    Tamaño máximo por archivo: 50 MB<br />
                    Los archivos se renombrarán automáticamente con un número de versión (ej: archivo_v001.pdf).<br />
                    Los archivos se subirán en paralelo para mayor velocidad.
                </small>
                <span asp-validation-for="Archivos" class="text-danger"></span>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="boton boton-primario">Subir Archivo(s)</button>
        <a href="/documentacion/listado@(!string.IsNullOrEmpty(Model.CarpetaRuta) ? $"?CarpetaRuta={Uri.EscapeDataString(Model.CarpetaRuta)}" : "")" class="boton boton-secundario">Cancelar</a>
    </div>
</form>
