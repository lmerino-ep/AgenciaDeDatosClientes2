@page "/documentacion/listado"
@model Pages.Documentacion.ListadoModel
@using Microsoft.AspNetCore.Authorization
@using Utils.Authorization

@{
    ViewData["Title"] = "Documentación";
    ViewBag.Description = "Gestión de documentación en Google Drive";
    ViewBag.PoliticaIndexFollow = "noindex, nofollow";
}

@section estilos {
    <environment include="Development">
        <link href="~/css/plugins/modalcargando.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
    <environment include="Staging,Production">
        <link href="~/css/plugins/modalcargando.min.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
}

@section scripts {
    <environment include="Development">
        <script defer src="~/js/plugins/modalcargando.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-listado.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script defer src="~/js/plugins/modalcargando.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-listado.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
}

<div class="page-header">
    <h1 class="page-title">Documentación</h1>
    <div class="breadcrumb">
        <a href="/">Dashboard</a>
        <span class="separador">/</span>
        <span>Documentación</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alerta alerta-error">
        @Model.MensajeError
    </div>
}

@if (Model.Permisos != null && !Model.Permisos.TieneAcceso)
{
    <div class="alerta alerta-advertencia">
        <p><strong>Acceso a Google Drive requerido</strong></p>
        <p>@Model.Permisos.Mensaje</p>
        <p>
            <a href="/documentacion/autorizar" class="boton boton-primario">Autorizar acceso a Google Drive</a>
        </p>
    </div>
}

<!-- Filtros -->
<section class="seccion-filtros">
    <div class="card">
        <h2 class="titulo-seccion">Filtros</h2>
        <form method="get" class="form-filtros">
            @if (!string.IsNullOrEmpty(Model.CarpetaId))
            {
                <input type="hidden" name="CarpetaId" value="@Model.CarpetaId" />
            }
            <div class="grid-filtros">
                <div class="form-group">
                    <label for="Busqueda">Búsqueda por nombre:</label>
                    <input type="text" name="Busqueda" id="Busqueda" class="form-control" value="@Model.Busqueda" placeholder="Buscar...">
                </div>

                <div class="form-group">
                    <label for="FiltroTipo">Tipo de archivo:</label>
                    <select name="FiltroTipo" id="FiltroTipo" class="form-control">
                        <option value="">Todos</option>
                        @if (Model.TiposDisponibles.Contains("pdf"))
                        {
                            <option value="pdf" selected="@(Model.FiltroTipo == "pdf")">PDF</option>
                        }
                        @if (Model.TiposDisponibles.Contains("word"))
                        {
                            <option value="word" selected="@(Model.FiltroTipo == "word")">Word</option>
                        }
                        @if (Model.TiposDisponibles.Contains("excel"))
                        {
                            <option value="excel" selected="@(Model.FiltroTipo == "excel")">Excel</option>
                        }
                        @if (Model.TiposDisponibles.Contains("powerpoint"))
                        {
                            <option value="powerpoint" selected="@(Model.FiltroTipo == "powerpoint")">PowerPoint</option>
                        }
                        @if (Model.TiposDisponibles.Contains("texto"))
                        {
                            <option value="texto" selected="@(Model.FiltroTipo == "texto")">Texto</option>
                        }
                        @if (Model.TiposDisponibles.Contains("imagenes"))
                        {
                            <option value="imagenes" selected="@(Model.FiltroTipo == "imagenes")">Imágenes</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="FiltroFecha">Fecha de modificación:</label>
                    <select name="FiltroFecha" id="FiltroFecha" class="form-control">
                        <option value="">Todo</option>
                        <option value="semana" selected="@(Model.FiltroFecha == "semana")">Última semana</option>
                        <option value="mes" selected="@(Model.FiltroFecha == "mes")">Último mes</option>
                        <option value="año" selected="@(Model.FiltroFecha == "año")">Último año</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="boton boton-primario">Filtrar</button>
                <a href="/documentacion/listado@(!string.IsNullOrEmpty(Model.CarpetaId) ? $"?CarpetaId={Model.CarpetaId}" : "")" class="boton boton-secundario">Limpiar</a>
                @if (Model.Permisos?.PuedeEscribir == true)
                {
                    <a href="/documentacion/subir" class="boton boton-primario">Subir Documento</a>
                }
            </div>
        </form>
    </div>
</section>

<!-- Breadcrumbs -->
@if (Model.Breadcrumbs.Any() || !string.IsNullOrEmpty(Model.CarpetaId))
{
    <section class="seccion-breadcrumbs">
        <div class="card">
            <div class="breadcrumb">
                <a href="/documentacion/listado" title="Carpeta raíz">Documentación</a>
                @if (Model.Breadcrumbs.Any())
                {
                    @foreach (var breadcrumb in Model.Breadcrumbs)
                    {
                        <span class="separador">/</span>
                        <a href="/documentacion/listado?CarpetaId=@breadcrumb.Id" title="@breadcrumb.Nombre">@breadcrumb.Nombre</a>
                    }
                }
                else if (!string.IsNullOrEmpty(Model.CarpetaId))
                {
                    <span class="separador">/</span>
                    <span>Carpeta</span>
                }
            </div>
        </div>
    </section>
}

<!-- Tabla de documentos -->
<section class="seccion-tabla">
    <div class="card">
        <div class="header-con-accion">
            <h2 class="titulo-seccion">Documentos (@Model.Archivos.Count)</h2>
        </div>

        @if (Model.Archivos.Any())
        {
            <div class="tabla-responsive">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Icono</th>
                            <th>Nombre</th>
                            <th>Tamaño</th>
                            <th>Última Modificación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var archivo in Model.Archivos)
                        {
                            <tr>
                                <td class="td-icono-centrado">
                                    @if (archivo.EsCarpeta)
                                    {
                                        <span class="icono">
                                            <span class="@archivo.IconoTipo">Carpeta</span>
                                        </span>
                                    }
                                    else if (archivo.EsShortcut)
                                    {
                                        <span class="icono">
                                            <span class="shortcut">Acceso directo</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="icono">
                                            <i class="@archivo.IconoTipo"></i>
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (archivo.EsCarpeta)
                                    {
                                        <a href="/documentacion/listado?CarpetaId=@archivo.Id" title="Abrir carpeta: @archivo.Nombre">
                                            @archivo.Nombre
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@archivo.UrlWeb" target="_blank" title="Abrir en Google Drive">
                                            @archivo.Nombre
                                        </a>
                                    }
                                </td>
                                <td>@archivo.TamanoFormateado</td>
                                <td>@(archivo.FechaModificacion != DateTime.MinValue ? archivo.FechaModificacion.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>
                                    <div class="acciones-tabla">
                                        @if (!archivo.EsCarpeta && !archivo.EsShortcut)
                                        {
                                            @if (Model.Permisos?.PuedeLeer == true)
                                            {
                                                <a href="/documentacion/descargar/@archivo.Id" class="boton boton-pequeno boton-secundario" data-js-descargar title="Descargar">
                                                    Descargar
                                                </a>
                                            }
                                            @if (Model.Permisos?.PuedeEscribir == true)
                                            {
                                                <a href="/documentacion/sobrescribir/@archivo.Id" class="boton boton-pequeno boton-secundario" title="Sobrescribir">
                                                    Sobrescribir
                                                </a>
                                            }
                                        }
                                        @if (Model.Permisos?.PuedeEliminar == true && !archivo.EsShortcut)
                                        {
                                            <form method="post" asp-page-handler="Eliminar" asp-route-id="@archivo.Id" class="form-inline" onsubmit="return confirm('¿Estás seguro de que deseas eliminar @(archivo.EsCarpeta ? "esta carpeta" : "este archivo")? Esta acción no se puede deshacer.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="boton boton-pequeno boton-peligro" title="Eliminar">
                                                    Eliminar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mensaje-vacio">
                <p>No se encontraron documentos con los filtros especificados.</p>
            </div>
        }
    </div>
</section>

