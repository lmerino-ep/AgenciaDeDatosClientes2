@page "/documentacion/listado"
@model Pages.Documentacion.ListadoModel
@using Microsoft.AspNetCore.Authorization
@using Utils.Authorization

@{
    ViewData["Title"] = "Documentación";
    ViewBag.Description = "Gestión de documentación en S3";
    ViewBag.PoliticaIndexFollow = "noindex, nofollow";
}

@section estilos {
    <environment include="Development">
        <link href="~/css/plugins/modalcargando.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
    <environment include="Staging,Production">
        <link href="~/css/plugins/modalcargando.min.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
}

@section scripts {
    <environment include="Development">
        <script defer src="~/js/plugins/modalcargando.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-listado.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script defer src="~/js/plugins/modalcargando.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/documentacion-listado.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
}

<div class="page-header">
    <h1 class="page-title">Documentación</h1>
    <div class="breadcrumb">
        <a href="/">Dashboard</a>
        <span class="separador">/</span>
        <span>Documentación</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alerta alerta-error">
        @Model.MensajeError
    </div>
}

@if (Model.Permisos != null && !Model.Permisos.TieneAcceso)
{
    <div class="alerta alerta-advertencia">
        <p><strong>Acceso a la documentación requerido</strong></p>
        <p>@Model.Permisos.Mensaje</p>
    </div>
}

<!-- Token antiforgery oculto para formularios dinámicos -->
@Html.AntiForgeryToken()

<!-- Filtros -->
<section class="seccion-filtros">
    <div class="card">
        <h2 class="titulo-seccion">Filtros</h2>
        <form method="get" class="form-filtros">
            @if (!string.IsNullOrEmpty(Model.CarpetaRuta))
            {
                <input type="hidden" name="CarpetaRuta" value="@Model.CarpetaRuta" />
            }
            <div class="grid-filtros">
                <div class="form-group">
                    <label for="Busqueda">Búsqueda por nombre:</label>
                    <input type="text" name="Busqueda" id="Busqueda" class="form-control" value="@Model.Busqueda" placeholder="Buscar...">
                </div>

                <div class="form-group">
                    <label for="FiltroTipo">Tipo de archivo:</label>
                    <select name="FiltroTipo" id="FiltroTipo" class="form-control">
                        <option value="">Todos</option>
                        @if (Model.TiposDisponibles.Contains("pdf"))
                        {
                            <option value="pdf" selected="@(Model.FiltroTipo == "pdf")">PDF</option>
                        }
                        @if (Model.TiposDisponibles.Contains("word"))
                        {
                            <option value="word" selected="@(Model.FiltroTipo == "word")">Word</option>
                        }
                        @if (Model.TiposDisponibles.Contains("excel"))
                        {
                            <option value="excel" selected="@(Model.FiltroTipo == "excel")">Excel</option>
                        }
                        @if (Model.TiposDisponibles.Contains("powerpoint"))
                        {
                            <option value="powerpoint" selected="@(Model.FiltroTipo == "powerpoint")">PowerPoint</option>
                        }
                        @if (Model.TiposDisponibles.Contains("texto"))
                        {
                            <option value="texto" selected="@(Model.FiltroTipo == "texto")">Texto</option>
                        }
                        @if (Model.TiposDisponibles.Contains("imagenes"))
                        {
                            <option value="imagenes" selected="@(Model.FiltroTipo == "imagenes")">Imágenes</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="FiltroFecha">Fecha de modificación:</label>
                    <select name="FiltroFecha" id="FiltroFecha" class="form-control">
                        <option value="">Todo</option>
                        <option value="semana" selected="@(Model.FiltroFecha == "semana")">Última semana</option>
                        <option value="mes" selected="@(Model.FiltroFecha == "mes")">Último mes</option>
                        <option value="año" selected="@(Model.FiltroFecha == "año")">Último año</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="boton boton-primario">Filtrar</button>
                <a href="/documentacion/listado@(!string.IsNullOrEmpty(Model.CarpetaRuta) ? $"?CarpetaRuta={Model.CarpetaRuta}" : "")" class="boton boton-secundario">Limpiar</a>
            </div>
        </form>
    </div>
</section>

<!-- Breadcrumbs -->
@if (Model.Breadcrumbs.Any())
{
    <section class="seccion-breadcrumbs">
        <div class="card">
            <div class="breadcrumb">
                @foreach (var breadcrumb in Model.Breadcrumbs)
                {
                    if (breadcrumb != Model.Breadcrumbs.Last())
                    {
                        // Extraer la ruta relativa preservando el case
                        string rutaBreadcrumb = breadcrumb.Key;
                        if (rutaBreadcrumb.StartsWith("documentacion/", StringComparison.OrdinalIgnoreCase))
                        {
                            rutaBreadcrumb = rutaBreadcrumb.Substring("documentacion/".Length);
                        }
                        rutaBreadcrumb = rutaBreadcrumb.TrimEnd('/');
                        <a href="/documentacion/listado?CarpetaRuta=@Uri.EscapeDataString(rutaBreadcrumb)" title="@breadcrumb.Nombre">@breadcrumb.Nombre</a>
                        <span class="separador">/</span>
                    }
                    else
                    {
                        <span>@breadcrumb.Nombre</span>
                    }
                }
            </div>
        </div>
    </section>
}

<!-- Tabla de documentos -->
<section class="seccion-tabla">
    <div class="card">
        <div class="header-con-accion">
            <h2 class="titulo-seccion">Documentos (@Model.Archivos.Count)</h2>
            @if (Model.Permisos?.PuedeEscribir == true)
            {
                <a href="/documentacion/subir@(!string.IsNullOrEmpty(Model.CarpetaRuta) ? $"?CarpetaRuta={Uri.EscapeDataString(Model.CarpetaRuta)}" : "")" class="boton boton-primario">Subir Documento</a>
            }
        </div>

        @if (Model.Archivos.Any())
        {
            <div class="tabla-responsive">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Icono</th>
                            <th>Nombre</th>
                            <th>Tamaño</th>
                            <th>Última Modificación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var archivo in Model.Archivos)
                        {
                            <tr>
                                <td class="td-icono-centrado">
                                    @if (archivo.EsCarpeta)
                                    {
                                        <span class="icono">
                                            <span class="@archivo.IconoTipo">Carpeta</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="icono">
                                            <i class="@archivo.IconoTipo"></i>
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (archivo.EsCarpeta)
                                    {
                                        // Extraer la ruta relativa preservando el case
                                        string rutaRelativa = archivo.Key;
                                        if (rutaRelativa.StartsWith("documentacion/", StringComparison.OrdinalIgnoreCase))
                                        {
                                            rutaRelativa = rutaRelativa.Substring("documentacion/".Length);
                                        }
                                        rutaRelativa = rutaRelativa.TrimEnd('/');
                                        <a href="/documentacion/listado?CarpetaRuta=@Uri.EscapeDataString(rutaRelativa)" title="Abrir carpeta: @archivo.Nombre">
                                            @archivo.Nombre
                                        </a>
                                    }
                                    else
                                    {
                                        <div>
                                            <a href="@archivo.UrlWeb" target="_blank" title="Abrir en S3">
                                                @(archivo.NombreBase ?? archivo.Nombre)
                                            </a>
                                            @if (archivo.NumeroVersion.HasValue)
                                            {
                                                <span class="version-badge">v@(archivo.NumeroVersion.Value)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>@archivo.TamanoFormateado</td>
                                <td>@(archivo.FechaModificacion != DateTime.MinValue ? archivo.FechaModificacion.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>
                                    <div class="acciones-tabla">
                                        @if (!archivo.EsCarpeta)
                                        {
                                            @if (Model.Permisos?.PuedeLeer == true)
                                            {
                                                <a href="/documentacion/descargar?key=@Uri.EscapeDataString(archivo.Key)" class="boton boton-pequeno boton-secundario" data-js-descargar title="Descargar">
                                                    Descargar
                                                </a>
                                            }
                                            @if (Model.Permisos?.PuedeEscribir == true)
                                            {
                                                <a href="/documentacion/sobrescribir?nombreBase=@Uri.EscapeDataString(archivo.NombreBase ?? archivo.Nombre)&carpetaRuta=@Uri.EscapeDataString(Model.CarpetaRuta ?? "")" class="boton boton-pequeno boton-secundario" title="Subir nueva versión">
                                                    Nueva Versión
                                                </a>
                                            }
                                        }
                                        @if (Model.Permisos?.PuedeEliminar == true && !archivo.EsCarpeta)
                                        {
                                            <button type="button" class="boton boton-pequeno boton-peligro" data-js-eliminar-archivo data-key="@Uri.EscapeDataString(archivo.Key)" data-nombre="@archivo.NombreBase" title="Eliminar">
                                                Eliminar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mensaje-vacio">
                <p>No se encontraron documentos con los filtros especificados.</p>
            </div>
        }
    </div>
</section>

<!-- Modal de eliminación -->
<div id="modal-eliminar-archivo" class="modal-eliminar-archivo" style="display: none;">
    <div class="modal-eliminar-archivo-contenido">
        <div class="modal-eliminar-archivo-header">
            <h3>Eliminar archivo</h3>
            <button type="button" class="modal-eliminar-archivo-cerrar" onclick="ocultarModalEliminacion()">&times;</button>
        </div>
        <div class="modal-eliminar-archivo-body">
            <p>¿Qué deseas hacer con el archivo <strong id="nombre-archivo-eliminar"></strong>?</p>
            <div class="opciones-eliminacion">
                <button type="button" class="boton boton-secundario" onclick="volverVersionAnterior()">
                    Volver a versión anterior
                </button>
                <button type="button" class="boton boton-peligro" onclick="eliminarCompletamente()">
                    Eliminar completamente
                </button>
            </div>
            <div class="info-eliminacion">
                <p><strong>Volver a versión anterior:</strong> Se eliminará la versión actual y se mostrará la versión anterior.</p>
                <p><strong>Eliminar completamente:</strong> Se eliminarán todas las versiones. La última versión se moverá a la papelera y se eliminará automáticamente pasados unos días.</p>
            </div>
        </div>
        <div class="modal-eliminar-archivo-footer">
            <button type="button" class="boton boton-secundario" onclick="ocultarModalEliminacion()">Cancelar</button>
        </div>
    </div>
</div>

