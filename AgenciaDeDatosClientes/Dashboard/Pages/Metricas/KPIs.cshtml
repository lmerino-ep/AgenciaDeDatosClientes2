@page "/metricas/kpis"
@model Pages.Metricas.KPIsModel
@{
    ViewData["Title"] = "Consulta de KPIs";
    ViewBag.Description = "Consulta de métricas y KPIs del sistema";
    ViewBag.PoliticaIndexFollow = "noindex, nofollow";
}

@section estilos {
    <environment include="Development">
        <link href="~/css/main/metricas.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/plugins/modalcargando.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
    <environment include="Staging,Production">
        <link href="~/css/main/metricas.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/main/usuarios.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
        <link href="~/css/plugins/modalcargando.min.css" rel="stylesheet" asp-append-version="true" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()" />
    </environment>
}

@section scripts {
    <!-- Datos de KPIs para metricas-kpis.js (plantilla inerte, no script ejecutable) -->
    <template id="kpis-data">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.KpisDisponibles.Select(k => new {
                id = k.Id,
                nombre = k.Nombre,
                descripcion = k.Descripcion,
                categoria = k.Categoria,
                parametros = k.Parametros.Select(p => new {
                    nombre = p.Nombre,
                    tipo = p.Tipo,
                    requerido = p.Requerido,
                    valorPorDefecto = p.ValorPorDefecto,
                    descripcion = p.Descripcion
                })
            })
        ))
    </template>

    @if (Model.Resultado != null && Model.Resultado.Datos.Count > 0)
    {
        <template id="resultado-datos">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Resultado.Datos))
        </template>
        <span id="nombre-kpi" hidden>@Model.Resultado.Nombre</span>
        <span id="kpi-id" hidden>@Model.Resultado.KpiId</span>
        
        <!-- Chart.js y plugin de datalabels solo se cargan si el KPI debe generar gráfico -->
        <script src="~/js/libs/chart.umd.min.js" asp-append-version="true" defer nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script src="~/js/libs/chartjs-plugin-datalabels.min.js" asp-append-version="true" defer nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    }

    <environment include="Development">
        <script defer src="~/js/plugins/modalcargando.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/metricas-kpis.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script defer src="~/js/plugins/modalcargando.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script defer src="~/js/main/metricas-kpis.min.js" fetchpriority="low" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
}

<div class="page-header">
    <h1 class="page-title">Consulta de Métricas y KPIs</h1>
    <div class="breadcrumb">
        <a href="/">Dashboard</a>
        <span class="separador">/</span>
        <span>Métricas y KPIs</span>
    </div>
</div>

<div class="container-metricas">

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-error">
            <strong>Error:</strong> @Model.MensajeError
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    <!-- Selector de KPI -->
    <div class="form-selector-kpi">
        <form method="get" id="formKpi">
            <div class="form-group">
                <label for="kpiSeleccionado">Seleccione un KPI:</label>
                <select name="kpiSeleccionado" id="kpiSeleccionado" class="form-control">
                    <option value="">-- Seleccione un KPI --</option>
                    @foreach (var categoria in Model.KpisDisponibles.GroupBy(k => k.Categoria))
                    {
                        <optgroup label="@categoria.Key">
                            @foreach (var kpi in categoria)
                            {
                                var isSelected = Model.KpiSeleccionado == kpi.Id;
                                <option value="@kpi.Id"
                                        data-parametros='@System.Text.Json.JsonSerializer.Serialize(kpi.Parametros)'
                                        selected="@isSelected">
                                    @kpi.Nombre
                                </option>
                            }
                        </optgroup>
                    }
                </select>
                <small class="form-text text-muted" id="descripcionKpi"></small>
            </div>

            <!-- Contenedor dinámico para parámetros -->
            <div id="contenedorParametros" class="form-group"></div>

            <!-- Opciones adicionales -->
            <div class="form-group">
                <label>
                    <input type="checkbox" name="forzarRecalculo" value="true" @(Model.ForzarRecalculo ? "checked" : "")>
                    Forzar recalculo (ignorar caché)
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="btnEjecutar">Ejecutar KPI</button>
                <button type="button" class="btn btn-secondary" id="btnLimpiar">Limpiar</button>
            </div>
        </form>
    </div>

    <!-- Resultados -->
    @if (Model.Resultado != null)
    {
        <div class="resultados-kpi">
            <h2>Resultados: @Model.Resultado.Nombre</h2>

            <!-- Información del resultado -->
            <div class="info-resultado">
                <div class="info-item">
                    <span class="label">Total de registros:</span>
                    <span class="value">@Model.Resultado.TotalRegistros</span>
                </div>
                <div class="info-item">
                    <span class="label">Duración:</span>
                    <span class="value">@Model.Resultado.DuracionMs ms</span>
                </div>
                <div class="info-item">
                    <span class="label">Desde caché:</span>
                    <span class="value">
                        @if (Model.Resultado.DesdCache)
                        {
                            <span class="badge badge-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge badge-info">No</span>
                        }
                    </span>
                </div>
                <div class="info-item">
                    <span class="label">Generado:</span>
                    <span class="value">@Model.Resultado.TimestampGeneracion.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
            </div>

            <!-- Botones de exportación -->
            <div class="acciones-exportacion">
                <a href="/Metricas/KPIs?handler=ExportarJson&kpiId=@Model.Resultado.KpiId&parametrosJson=@System.Text.Json.JsonSerializer.Serialize(Model.Resultado.Parametros)"
                   class="btn btn-export btn-json" id="btnExportarJson">
                    <i class="icon-download"></i> Exportar JSON
                </a>
                <a href="/Metricas/KPIs?handler=ExportarCsv&kpiId=@Model.Resultado.KpiId&parametrosJson=@System.Text.Json.JsonSerializer.Serialize(Model.Resultado.Parametros)"
                   class="btn btn-export btn-csv" id="btnExportarCsv">
                    <i class="icon-download"></i> Exportar CSV
                </a>
            </div>

            <!-- Gráfico (visualización principal) -->
            @if (Model.Resultado.Datos.Count > 0)
            {
                <div class="contenedor-grafico">
                    <div class="contenedor-canvas">
                        <canvas id="chartKpi"></canvas>
                    </div>
                </div>
            }

            <!-- Tabla de resultados (colapsable) -->
            @if (Model.Resultado.Datos.Count > 0)
            {
                <div class="tabla-resultados">
                    <div class="tabla-header">
                        <h3>Datos en tabla</h3>
                        <button type="button" id="btnToggleTabla" class="btn btn-secondary">
                            <span id="textoToggleTabla">Mostrar tabla</span>
                        </button>
                    </div>
                    <div id="contenidoTabla" class="tabla-contenido-oculto">
                        <div class="tabla-scroll">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        @foreach (var columna in Model.Resultado.Datos[0].Keys)
                                        {
                                            <th>@columna</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fila in Model.Resultado.Datos.Take(100))
                                    {
                                        <tr>
                                            @foreach (var valor in fila.Values)
                                            {
                                                <td>@(valor?.ToString() ?? "-")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (Model.Resultado.Datos.Count > 100)
                        {
                            <p class="nota-paginacion">
                                Mostrando los primeros 100 de @Model.Resultado.TotalRegistros registros.
                                Use la exportación para obtener el conjunto completo de datos.
                            </p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="sin-resultados">
                    <p>No se encontraron resultados para este KPI con los parámetros especificados.</p>
                </div>
            }
        </div>
    }
</div>