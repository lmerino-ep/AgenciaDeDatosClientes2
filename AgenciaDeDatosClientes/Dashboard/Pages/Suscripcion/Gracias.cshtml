@page "/suscripcion/gracias"
@model Pages.Suscripcion.GraciasModel
@{
    ViewData["Title"] = "Suscripción activada";
}

<div class="suscripcion-flujo-gracias">
    <header class="suscripcion-flujo-gracias-hero" role="banner">
        <div class="suscripcion-flujo-gracias-medalla" aria-hidden="true">
            <svg class="suscripcion-flujo-gracias-icono-check" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2.5" fill="none" opacity="0.35" />
                <circle cx="24" cy="24" r="18" fill="currentColor" opacity="0.12" />
                <path d="M15 24.5l6 6 12-14" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
        </div>
        <h1 class="suscripcion-flujo-gracias-titulo">¡Gracias por unirte a EpData!</h1>
        <p class="suscripcion-flujo-gracias-lead">
            Tu suscripción está <strong>activa</strong>. Acabas de apoyar un proyecto que pone los datos oficiales al alcance de quien los necesita.
        </p>
        <p class="suscripcion-flujo-gracias-meta">
            En unos segundos tendrás los permisos actualizados. Si no ves el cambio al instante, prueba a <strong>recargar la página</strong>.
        </p>
    </header>

    <section class="suscripcion-flujo-gracias-refuerzo" aria-labelledby="gracias-refuerzo-titulo">
        <h2 class="suscripcion-flujo-gracias-seccion-titulo" id="gracias-refuerzo-titulo">Has tomado una buena decisión</h2>
        <ul class="suscripcion-flujo-gracias-tarjetas">
            <li class="suscripcion-flujo-gracias-tarjeta">
                <span class="suscripcion-flujo-gracias-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><ellipse cx="12" cy="6" rx="7" ry="3" stroke="currentColor" stroke-width="1.6"/><path d="M5 6v4c0 1.66 3.13 3 7 3s7-1.34 7-3V6M5 10v4c0 1.66 3.13 3 7 3s7-1.34 7-3v-4M5 14v4c0 1.66 3.13 3 7 3s7-1.34 7-3v-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <span class="suscripcion-flujo-gracias-tarjeta-texto">
                    <strong>Datos fiables</strong> — series y tablas desde fuentes oficiales, listas para analizar.
                </span>
            </li>
            <li class="suscripcion-flujo-gracias-tarjeta">
                <span class="suscripcion-flujo-gracias-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="suscripcion-flujo-gracias-tarjeta-texto">
                    <strong>Tu ritmo</strong> — descargas y formatos que encajan con tu trabajo (incluido el plan que has elegido).
                </span>
            </li>
            <li class="suscripcion-flujo-gracias-tarjeta">
                <span class="suscripcion-flujo-gracias-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                </span>
                <span class="suscripcion-flujo-gracias-tarjeta-texto">
                    <strong>Pago transparente</strong> — facturación con Stripe; desde el dashboard puedes revisar tu suscripción cuando quieras.
                </span>
            </li>
        </ul>
    </section>

    <section class="suscripcion-flujo-gracias-cta" aria-labelledby="gracias-cta-titulo">
        <h2 class="suscripcion-flujo-gracias-cta-titulo" id="gracias-cta-titulo">¿Y ahora qué?</h2>
        <p class="suscripcion-flujo-gracias-cta-texto">
            Vuelve al dashboard para explorar series, guardar favoritos y sacar partido a tu plan.
        </p>
        <div class="suscripcion-flujo-gracias-acciones">
            <a href="/" class="suscripcion-flujo-gracias-btn-primario">Ir al dashboard</a>
            <a href="/clientes/suscripciones" class="suscripcion-flujo-gracias-btn-secundario">Gestionar mi suscripción</a>
        </div>
    </section>

    <p class="suscripcion-flujo-gracias-pie">
        ¿Necesitas ayuda para empezar? <a href="mailto:contacto@epdata.es" class="suscripcion-flujo-gracias-enlace-pie">Escríbenos</a>
        <span class="suscripcion-flujo-gracias-pie-sep" aria-hidden="true">·</span>
        <a href="https://www.epdata.es/contacto" target="_blank" rel="noopener noreferrer" class="suscripcion-flujo-gracias-enlace-pie">Contacto EpData</a>
    </p>
</div>
