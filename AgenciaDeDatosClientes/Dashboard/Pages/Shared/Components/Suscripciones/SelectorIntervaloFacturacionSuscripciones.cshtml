@* Selector Anual / Mensual (facturación Profesional). Debe ir entre el subtítulo de la landing y las tarjetas de planes. *@

<div class="suscripciones-intervalo" id="suscripciones-intervalo-facturacion">

    <div class="suscripciones-intervalo-pista" id="suscripciones-intervalo-pista" data-intervalo-seleccionado="anual" role="tablist" aria-label="Facturación del plan Profesional">

        <span class="suscripciones-intervalo-indicador" aria-hidden="true"></span>

        <button type="button"

                class="suscripciones-intervalo-opcion is-active"

                id="suscripciones-intervalo-tab-anual"

                role="tab"

                aria-selected="true"

                aria-controls="suscripcion-plan-profesional"

                data-intervalo="anual">

            Anual

        </button>

        <button type="button"

                class="suscripciones-intervalo-opcion"

                id="suscripciones-intervalo-tab-mensual"

                role="tab"

                aria-selected="false"

                aria-controls="suscripcion-plan-profesional"

                data-intervalo="mensual">

            Mensual

        </button>

    </div>

</div>

