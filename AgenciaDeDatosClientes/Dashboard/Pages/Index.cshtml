@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard de Gestión";
}

@section scripts {
    <environment include="Development">
        <script src="~/js/libs/chart.umd.min.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script src="~/js/main/dashboard.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="~/js/libs/chart.umd.min.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script src="~/js/main/dashboard.min.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>

    <script type="application/json" id="datos-graficos" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            actividadMensual = Model.ActividadMensualUltimos6Meses,
                accionesPorModulo = Model.AccionesPorModuloHoy,
                actividadDiaria = Model.ActividadDiariaUltimos7Dias
        }))
</script>
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">Bienvenido al Dashboard de Gestión</h1>
    <p class="page-description">
        Panel de control administrativo para la gestión de usuarios, métricas y documentación de EpData.
    </p>
</div>

@if (!(User?.Identity?.IsAuthenticated ?? false))

{

    <!-- Mensaje para usuarios no autenticados -->
    <section class="seccion-mensaje-no-autenticado">
        <div class="card-mensaje">
            <p class="mensaje-texto">
                Este es un dashboard interno de gestión de EpData. Debes iniciar sesión para acceder a sus funciones.
            </p>
            <a asp-page="/login" class="btn-iniciar-sesion">Iniciar sesión</a>
        </div>
    </section>
}
else
{
    <div class="dashboard-contenedor">
        @if (Model.EsUsuarioAdmin)
        {
            @await Html.PartialAsync("Shared/Components/DashboardAdmin", Model);
        }
        else
        {
            @await Html.PartialAsync("Shared/Components/DashboardCliente", Model);
        }
    </div>
}
