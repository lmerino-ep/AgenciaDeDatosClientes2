@page
@model IndexModel
@{
    ViewData["Title"] = Model.TituloPaginaDashboard;
}

@section scripts {
    <environment include="Development">
        <script src="~/js/libs/chart.umd.min.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script src="~/js/main/dashboard.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="~/js/libs/chart.umd.min.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
        <script src="~/js/main/dashboard.min.js" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()"></script>
    </environment>

    <script type="application/json" id="datos-graficos" nonce="@HttpContext.Items["CSP_NONCE"]?.ToString()">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            esProveedor = Model.EsProveedor,
            actividadMensual = Model.EsProveedor ? Model.ProveedorActividadMensual : Model.ActividadMensualUltimos6Meses,
            accionesPorModulo = Model.AccionesPorModuloHoy,
            actividadDiaria = Model.EsProveedor ? Model.ProveedorActividadDiaria : Model.ActividadDiariaUltimos7Dias,
            descargasPorFormato = Model.ProveedorDescargasPorFormato
        }))
</script>
}

<div class="dashboard-hilo-principal">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">@Model.TituloBienvenida</h1>
        <p class="page-description">@Model.DescripcionBienvenida</p>
    </div>

    @if (!(User?.Identity?.IsAuthenticated ?? false))
    {
        <!-- Mensaje para usuarios no autenticados -->
        <section class="seccion-mensaje-no-autenticado">
            <div class="card-mensaje">
                <p class="mensaje-texto">
                    Este es un dashboard interno de gestión de EpData. Debes iniciar sesión para acceder a sus funciones.
                </p>
                <a asp-page="/login" class="btn-iniciar-sesion">Iniciar sesión</a>
            </div>
        </section>
    }
    else
    {
        <div class="dashboard-contenedor">
            @if (Model.EsTrabajadorEuropaPress)
            {
                @await Html.PartialAsync("Shared/Components/DashboardAdmin", Model);
            }
            else if (Model.EsProveedor)
            {
                @await Html.PartialAsync("Shared/Components/DashboardProveedor", Model);
            }
            else if (Model.TieneSuscripcionActiva)
            {
                @await Html.PartialAsync("Shared/Components/DashboardClienteSuscripcionActiva", Model);
            }
            else
            {
                @await Html.PartialAsync("Shared/Components/DashboardClientePlanFree", Model);
            }
        </div>
    }
</div>
