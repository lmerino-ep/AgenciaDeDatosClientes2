{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "MaxRequestBodySize": 52428800,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "Sqs": {
    "ColasSerieTipo": {
      "ColaPrioridadAlta": "serietipo-actualizado-prioridad-alta",
      "ColaPrioridadMedia": "serietipo-actualizado-prioridad-media",
      "ColaPrioridadBaja": "serietipo-actualizado-prioridad-baja"
    },
    "ColasRepresentacion": {
      "ColaPrioridadAlta": "representacion-actualizada-prioridad-alta",
      "ColaPrioridadMedia": "representacion-actualizada-prioridad-media",
      "ColaPrioridadBaja": "representacion-actualizada-prioridad-baja"
    },
    "ColasPlantillaWeb": {
      "ColaPrioridadAlta": "plantillaweb-actualizada-prioridad-alta",
      "ColaPrioridadMedia": "plantillaweb-actualizada-prioridad-media",
      "ColaPrioridadBaja": "plantillaweb-actualizada-prioridad-baja"
    },
    "NumeroMaximoDeMensajesPorRequest": 1,
    "LimiteDeSegundosDeEsperaHastaRecibirMensajes": 5,
    "SegundosOcultoParaSucesivasRequestsDespuesDeHaberSidoConsultadoPorNuestroProceso": 300,
    "SegundosDeEsperaSiNoHayMensajesQueProcesar": 10
  },
  "Google": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-google-oauth",
    "SecretoClaveInstance": "epdata-google-oauth-instance",
    "SecretoClaveClientId": "epdata-google-oauth-clientid",
    "SecretoClaveClientSecret": "epdata-google-oauth-clientsecret",
    "SecretoClaveCallbackPath": "epdata-google-oauth-callbackpath",
    "SecretoClaveReCaptchaClaveSitio": "epdata-google-oauth-recaptchaclavesitio",
    "SecretoClaveReCaptchaClaveSecreta": "epdata-google-oauth-recaptchaclavesecreta"
  },
  "AutoLogin": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-autologin",
    "SecretoClaveSecretKeys": "epdata-autologin-secretkeys",
    "SecretoClaveEndPoint": "epdata-autologin-endpoint",
    "SecretoClaveAccountName": "epdata-autologin-accountname",
    "SecretoClaveAccountKey": "epdata-autologin-accountkey",
    "SecretoClaveStorageConnectionString": "epdata-autologin-storageconnectionstring",
    "SecretoClaveTableName": "epdata-autologin-tablename"
  },
  "Redis": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-valkey",
    "SecretoClaveHost": "epdata-valkey-host",
    "SecretoClaveUsarSSL": "epdata-valkey-usarssl",
    "SecretoClaveSegundosTimeout": "epdata-valkey-segundostimeout",
    "SecretoClaveConnectTimeout": "epdata-valkey-connectTimeout",
    "SecretoClaveSyncTimeout": "epdata-valkey-syncTimeout"
  },
  "Aurora": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-aurora",
    "SecretoClaveLectura": "epdata-aurora-lectura",
    "SecretoClaveEscritura": "epdata-aurora-escritura"
  },
  "CDN": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-cdn-transparent",
    "SecretoClaveClientId": "epdata-cdn-transparent-clientid",
    "SecretoClaveClientSecret": "epdata-cdn-transparent-clientsecret",
    "SecretoClaveCompanyId": "epdata-cdn-transparent-companyid"
  },
  "S3": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-s3",
    "SecretoClaveBucket": "epdata-s3-bucket",
    "SecretoClaveAccessKeyId": "epdata-s3-accesskeyid",
    "SecretoClaveCloudfrontDistributionId": "epdata-s3-cloudfrontdistributionid",
    "SecretoClaveSecretAccessKey": "epdata-s3-secretaccesskey"
  },
  "CloudWatch": {
    "Region": "eu-west-1",
    "LogGroupName": "/ecs/epdata/clientes"
  },
  "FirehoseLogs": {
    "Enabled": true,
    "DeliveryStreamName": "epdata-clientes-logs-production"
  },
  "AWS": {
    "Region": "eu-west-1"
  },
  "Zilliz": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-zilliz",
    "SecretoClaveLimiteBulkInsert": "epdata-zilliz-limitebulkinsert",
    "SecretoClaveNombreColeccion": "epdata-zilliz-nombrecoleccion",
    "SecretoClaveAlgoritmoCalculoSimilitud": "epdata-zilliz-algoritmocalculosimilitud",
    "SecretoClaveApiKey": "epdata-zilliz-apikey",
    "SecretoClaveEndpoint": "epdata-zilliz-endpoint"
  },
  "OpenAI": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-openai",
    "SecretoClaveDimensionesVector": "epdata-openai-dimensionesvector",
    "SecretoClaveSegundosTimeOut": "epdata-openai-segundostimeout",
    "SecretoClaveModelo": "epdata-openai-modelo",
    "SecretoClaveApiKey": "epdata-openai-apikey",
    "SecretoClaveEndpoint": "epdata-openai-endpoint"
  },
  "Anthropic": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-anthropic",
    "SecretoClaveModelo": "epdata-anthropic-modelo",
    "SecretoClaveClave": "epdata-anthropic-clave",
    "SecretoClaveEndpoint": "epdata-anthropic-endpoint"
  },
  "Stripe": {
    "UseSecretsManager": true,
    "NombreDelSecreto": "epdata-stripe",
    "SecretoClaveSecretKey": "epdata-stripe-secretkey",
    "SecretoClavePublishableKey": "epdata-stripe-publishablekey",
    "SecretoClaveWebhookSecret": "epdata-stripe-webhooksecret",
    "CheckoutSuccessPath": "/suscripcion/gracias",
    "CheckoutCancelPath": "/suscripcion/cancelada"
  },
  "Configuracion": {
    "MaxDegreeOfParallelism": 32,
    "SegundosETagParaSitemap": 600,
    "LimiteUrlsPorArchivoDeSitemap": 5000,
    "UrlBasePublicacionEpData": "https://www.epdata.es"
  }
}
